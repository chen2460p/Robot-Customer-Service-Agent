# ============================================================================
# 环境变量模板
# ============================================================================
# 用法：
#   1. 复制本文件为 .env         cp .env.example .env
#   2. 在 .env 中填入真实值
#   3. .env 已被 .gitignore 排除，不会被提交
#
# 代码读取位置：model/factory.py（经 python-dotenv 自动加载）
# ============================================================================

# 通义千问（DashScope）API Key —— 必填
# 获取地址：https://bailian.console.aliyun.com/  →  API-KEY 管理
DASHSCOPE_API_KEY=sk-在此填入你的密钥
